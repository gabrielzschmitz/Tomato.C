# ============================================================
# LONGPAUSE
# ============================================================

[animation.longpause]
icon-type = ["nerd-icons", "emojis", "ascii"]
default-frame-duration = "2.25s"
loop = true
default-color = 7

[[frame]]
[[content]]
\c{3}     |
\c{3}   \ _ /
\c{3} -= (_) =-
\c{3}   /   \        \c{2}_\/_
\c{3}     |          \c{2}/\c{7}o\c{2}\\ _\/_
\c{4}_ _ __ __ ____ _ \c{7}|\c{4}__ \c{2}/\c{7}o\c{2}\\
\c{4}__=_-= _=_=-=\c{7}_,-'|"'""-|-
\c{4}-=- -_=-=\c{7}_,-"          |
\c{4}=- -=\c{7}.--"
[[/content]]
[[/frame]]

[[frame]]
[[content]]
\c{3}
\c{3}   \ | /
\c{3}  - (_) -
\c{3}   / | \       \c{2}_\/_
\c{2}               //\c{7}o\c{2}\ _\/_
\c{4}__ ____ __  ____ \c{7}|\c{4}_ \c{2}//\c{7}o\c{2}\\c{4}_
\c{4}--_=-__=  _-=\c{7}_,-'|"'""-|-
\c{4}_-= _=-_=\c{7}_,-"          |
\c{4}-= _-\c{7}.--"
[[/content]]
[[/frame]]
