# ============================================================
# WORKTIME
# ============================================================

[animation.worktime]
icon-type = ["nerd-icons", "emojis", "ascii"]
default-frame-duration = "3.0s"
loop = true
default-color = 7

[[frame]]
[[content]]
\c{0}   ) )
\c{0}  ( (
\c{7}.......
\c{7}|     |]
\c{7}\     /
\c{7} `---'
[[/content]]
[[/frame]]

[[frame]]
[[content]]
\c{0} ( (
\c{0}  ) )
\c{7}.......
\c{7}|     |]
\c{7}\     /
\c{7} `---'
[[/content]]
[[/frame]]
